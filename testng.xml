<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Torsavo E2E Suite" verbose="1" parallel="methods" thread-count="3">
    <!-- TestListener is registered via @Listeners on BaseTest, so it applies
         whether tests run from the IDE or from this suite file.

         parallel="methods": each @Test method runs on its own thread with its own
         browser. Driver, report node, test data and soft asserts are ThreadLocal, and
         every signed-in test registers its own throwaway customer, so tests never share
         a cart. Raise thread-count on a bigger machine (consider headless=true).

         100 tests: 40 tagged "smoke" (+ regression), 60 "regression" only.
           mvn test -Dgroups=smoke         -> 40 business-critical checks
           mvn test -Dgroups=regression    -> all 100 -->
    <test name="Torsavo Storefront">
        <classes>
            <class name="tests.HomePageTest"/>
            <class name="tests.HeaderSearchTest"/>
            <class name="tests.LoginTest"/>
            <class name="tests.RegisterTest"/>
            <class name="tests.ShopTest"/>
            <class name="tests.ProductPageTest"/>
            <class name="tests.CartTest"/>
            <class name="tests.CheckoutTest"/>
            <class name="tests.AccountTest"/>
            <class name="tests.ContentPagesTest"/>
            <class name="tests.FooterAndSeoTest"/>
            <class name="tests.AdminTest"/>
        </classes>
    </test>
</suite>
